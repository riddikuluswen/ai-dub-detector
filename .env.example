# Telegram bot token from BotFather.
TELEGRAM_BOT_TOKEN=123456:replace-me

# Optional comma-separated Telegram user IDs. Leave empty to allow everyone who can reach the bot.
AI_DUB_ALLOWED_USER_IDS=

# Default model used by both CLI and Telegram bot.
AI_DUB_MODEL_ID=Hemgg/Deepfake-audio-detection

# Keep downloads and temporary reports here.
AI_DUB_WORK_DIR=./_work

# The app defaults to ./.cache/huggingface for model downloads.
# Set this only if you intentionally want another location.
# HF_HOME=./.cache/huggingface
